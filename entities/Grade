{
  "name": "Grade",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "subject_name": {
      "type": "string"
    },
    "section_id": {
      "type": "string"
    },
    "grade_level": {
      "type": "string"
    },
    "school_year_id": {
      "type": "string"
    },
    "quarter": {
      "type": "string",
      "enum": [
        "Q1",
        "Q2",
        "Q3",
        "Q4"
      ]
    },
    "written_work_score": {
      "type": "number",
      "description": "Written Works raw score"
    },
    "written_work_total": {
      "type": "number",
      "description": "Written Works highest possible score"
    },
    "performance_task_score": {
      "type": "number"
    },
    "performance_task_total": {
      "type": "number"
    },
    "quarterly_exam_score": {
      "type": "number"
    },
    "quarterly_exam_total": {
      "type": "number"
    },
    "written_work_ps": {
      "type": "number",
      "description": "Percentage Score for Written Works"
    },
    "performance_task_ps": {
      "type": "number",
      "description": "Percentage Score for Performance Tasks"
    },
    "quarterly_exam_ps": {
      "type": "number",
      "description": "Percentage Score for Quarterly Exam"
    },
    "written_work_ws": {
      "type": "number",
      "description": "Weighted Score (PS * weight)"
    },
    "performance_task_ws": {
      "type": "number",
      "description": "Weighted Score"
    },
    "quarterly_exam_ws": {
      "type": "number",
      "description": "Weighted Score"
    },
    "quarterly_grade": {
      "type": "number",
      "description": "Final quarterly grade (sum of weighted scores)"
    },
    "remarks": {
      "type": "string",
      "enum": [
        "Passed",
        "Failed",
        ""
      ],
      "default": ""
    },
    "is_locked": {
      "type": "boolean",
      "default": false,
      "description": "Whether grade is locked (final term only)"
    }
  },
  "required": [
    "student_id",
    "subject_id",
    "quarter"
  ]
}